{
  "hosting": {
    "public": "build/jaspr/web",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/api/**",
        "run": {
          "serviceId": "potube-converter-api",
          "region": "europe-west1"
        }
      },
      {
        "source": "**",
        "run": {
          "serviceId": "potube-web",
          "region": "europe-west1"
        }
      }
    ]
  }
}
